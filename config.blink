option TypesOutput = "src/Shared/Network/Types.luau"
option ClientOutput = "src/Shared/Network/Client.luau"
option ServerOutput = "src/Shared/Network/Server.luau"
option PromiseLibrary = "ReplicatedStorage.Packages.Promise"
option FutureLibrary = "ReplicatedStorage.Packages.Future"
option Casing = Pascal
option Typescript = true

type data = unknown
type player = unknown
type version = i32





----PlayerProfile

event ProfileUpdated {
    From: Server,
    Type: Reliable,
    Call: ManyAsync,
    Data: (data, version?),
}

function GetProfile {
    Yield: Coroutine,
    Return: (data, version?),
}

function Preload {
    Yield: Coroutine,
    Return: boolean,
}


--  Garden
scope Garden {
    type slot = u16
    type plant = string

    event Init {
        From: Server,
        Type: Reliable,
        Call: ManyAsync,
        Data: slot,
    }

    event Sow {
        From: Client,
        Type: Reliable,
        Call: ManyAsync,
        Data: plant,
    }
}